{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appg",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "74a84668-e7b4-4df1-9287-a435c5eed70e","database_name": "web-appp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7a7dd98b2de34e539c0d9744e24cb250" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
